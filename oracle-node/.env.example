# NEAR Configuration
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org

# Oracle contract ID (the light-client replacement)
ORACLE_CONTRACT_ID=oracle.kaiyang.testnet

# This oracle node's NEAR account and key
ORACLE_ACCOUNT_ID=oracle-node-1.kaiyang.testnet
ORACLE_PRIVATE_KEY=ed25519:xxxxx

# Orderbook contract (for deriving MPC addresses)
ORDERBOOK_CONTRACT_ID=ob.kaiyang.testnet
MPC_CONTRACT_ID=v1.signer-prod.testnet

# External chain RPCs
ETH_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SUI_RPC_URL=https://fullnode.testnet.sui.io:443
AVAX_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Poll interval in milliseconds
POLL_INTERVAL_MS=15000

# Minimum confirmations before attesting
ETH_CONFIRMATIONS=3
SUI_CONFIRMATIONS=1
AVAX_CONFIRMATIONS=3

# Optional: HTTP API for permissionless review requests
ORACLE_REQUEST_API_ENABLED=true
ORACLE_REQUEST_API_HOST=0.0.0.0
ORACLE_REQUEST_API_PORT=8787
ORACLE_REQUEST_API_ALLOWED_ORIGIN=*
